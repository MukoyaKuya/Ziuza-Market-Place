# Django Settings
DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=django-insecure-change-me-in-production-ziuza-marketplace-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration
# Local defaults to SQLite when unset. Production requires PostgreSQL.
# DATABASE_URL=postgres://user:password@localhost:5432/ziuza_db

# Cache & Redis (optional). LocMem is used when unset. Correctness does not depend on Redis.
# REDIS_URL=redis://127.0.0.1:6379/1

# Object storage (optional; requires [prod] extra django-storages[s3]).
# Empty = local disk (single host). Set both to share media across app servers.
# MEDIA_STORAGE_BACKEND=storages.backends.s3.S3Storage
# MEDIA_STORAGE_OPTIONS={"bucket_name":"ziuza-media","endpoint_url":"https://s3.eu-west-1.amazonaws.com"}
# PRIVATE_MEDIA_STORAGE_BACKEND=storages.backends.s3.S3Storage
# PRIVATE_MEDIA_STORAGE_OPTIONS={"bucket_name":"ziuza-private"}

# Celery Task Queue & Broker
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# Payments: fake (sandbox confirm UI) or mpesa (Daraja STK scaffold)
PAYMENT_PROVIDER=fake
# MPESA_DARAJA_ENABLED=False
# MPESA_LIVE=False
# MPESA_CALLBACK_SECRET=
# MPESA_CALLBACK_URL=https://your-domain.example/payments/callback/mpesa/
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# MPESA_HTTP_TIMEOUT=15
ORDER_RESERVATION_MINUTES=30

# Public links and queued notification email delivery
PUBLIC_SITE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=Ziuza Marketplace <notifications@example.com>
# Production SMTP example (local development prints email to the console)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=15

# Enable only behind a trusted proxy that replaces X-Forwarded-For.
TRUST_X_FORWARDED_FOR=False

# Optional Sentry (production). Requires: pip install -e ".[prod]"
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.0

# Production security toggles (used by config.settings.production)
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
# DJANGO_BEHIND_PROXY=False
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
